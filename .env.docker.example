# ─── Shalom Backend Docker Environment ───
# Copia este archivo a .env y ajusta los valores según tu entorno
# docker-compose --env-file .env up -d

# ─── Email / Brevo (ServiceUser) ───
BREVO_API_KEY=tu_api_key_de_brevo
EMAIL_FROM=noreply@tudominio.com

# ─── JWT Secret (debe ser igual en todos los servicios) ───
JWT_SECRET=nosexd

# ─── Database (PostgreSQL) ───
DB_HOST=postgres
DB_PORT=5432
DB_USER=ShalomAccess
DB_NAME=ShalomDB
DB_PASS=ShAloM4

# ─── Redis ───
REDIS_URL=redis
REDIS_PORT=6379

# ─── MinIO ───
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword
CLAMAV_HOST=shalom_antivirus
CLAMAV_PORT=3310

# ─── Gateway / RestAPI ───
GATEWAY_PUBLIC_URL=http://localhost:5141
ASPNETCORE_ENVIRONMENT=Development

# ─── Internal ───
INTERNAL_PUSH_TOKEN=shalom-internal-push

# Servicio LLM / RAG (Redis RAG y Ollama están en el stack de infraestructura)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_GEMMA_MODEL=gemma4:e4b
OLLAMA_MISTRAL_MODEL=mistral:7b
# Debe ser un modelo de embeddings ya instalado manualmente en Ollama.
OLLAMA_EMBEDDING_MODEL=
REDIS_RAG_HOST=host.docker.internal
REDIS_RAG_PORT=6380
REDIS_RAG_USERNAME=rag_user
REDIS_RAG_PASSWORD=
REDIS_RAG_DB=0
LLM_WEBHOOK_SECRET=
LLM_CHUNK_SIZE=6000
LLM_CHUNK_OVERLAP=500
LLM_MAX_CHUNKS_PER_DOCUMENT=200
LLM_ACCEPTANCE_THRESHOLD=0.97
LLM_MAX_REFINEMENT_ITERATIONS=3
LLM_REQUEST_TIMEOUT=240
LLM_MAX_CONCURRENCY=2
LLM_WORKER_COUNT=1
LLM_JOB_MAX_RETRIES=3
QUIZ_ADVANCE_THRESHOLD=0.8
QUIZ_RETAIN_THRESHOLD=0.6

# ─── Academic Service ───
SEG_TRIMESTRE_ACTUAL=1
SEG_NOTA_RIESGO=60
SEG_NOTA_RIESGO_ALTO=50
SEG_ASISTENCIA_RIESGO=75
SEG_ASISTENCIA_RIESGO_ALTO=60
SEG_ASISTENCIA_OBSERVACION=85
SEG_PESO_PROMEDIO=0.7
SEG_PESO_ASISTENCIA=0.3
