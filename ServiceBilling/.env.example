# Servidor
PORT=8886

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=ShalomAccess
DB_NAME=ShalomDB
DB_PASS=
DB_SSL=false
DB_POOL=10

# Redis
REDIS_URL=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# JWT (mismo secreto que ServiceUser y los demás servicios)
JWT_SECRET=nosexd

# Canal de eventos de dominio (pub/sub)
EVENTOS_CANAL=notificaciones:eventos

# Push en tiempo real hacia el gateway (RestApi)
GATEWAY_PUBLIC_URL=http://localhost:5141
INTERNAL_PUSH_TOKEN=shalom-internal-push